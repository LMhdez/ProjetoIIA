extensions [table]
globals [
  mapa-cores 
  recursos-coletados 
  total-recursos 
  centro-base 
  cor-obstaculo 
  cor-recurso 
  cor-base 
  cor-feromona
  cor-coletores
  cor-exploradores
  cor-vazio
]

breed [coletores coletor]  
breed [exploradores explorador]

coletores-own [
  velocidade
  energia
  fov
  estado
  dov
  carga
]

exploradores-own [
  velocidade
  energia
  fov
  estado
  dov
]

patches-own [
  cor-inicial
  recurso
  feromona
  tempo-exposto
]

to setup
  clear-all

  set recursos-coletados 0
  set total-recursos 0

  set mapa-cores table:from-list [[red 2] [blue 5] [pink 7]]
  set cor-obstaculo gray
  set cor-recurso brown
  set cor-base yellow
  set cor-feromona violet
  set cor-coletores orange
  set cor-vazio green
  set cor-exploradores blue
  
  ask patches [
    set pcolor cor-vazio
    set recurso 0
    set feromona 0
    set tempo-exposto 0
  ]
  
  ask patches [
    if random 101 <= 5 [
      set pcolor cor-obstaculo
    ]
  ]

  ;; GERAÇÃO DINÂMICA DA BASE (Procura um local seguro)
  let locais-seguros patches with [
    pxcor > min-pxcor + 5 and pxcor < max-pxcor - 5 and 
    pycor > min-pycor + 5 and pycor < max-pycor - 5 and
    all? patches in-radius 3 [ pcolor = cor-vazio ]
  ]
  
  ifelse any? locais-seguros [
    set centro-base one-of locais-seguros
    ask centro-base [
      ask patches in-radius 2.9 [
        set pcolor cor-base
      ]
    ]
  ] [
    ;; Se não encontrou espaço, refaz o mapa!
    setup
    stop
  ]

  ;; GERAÇÃO DOS RECURSOS (Longe da nova base)
  ask n-of 5 patches with [pcolor = cor-vazio and distance centro-base > 5 and pcolor != cor-obstaculo] [
    let chaves-cores table:keys mapa-cores
    let cor-aleatoria one-of chaves-cores
    set pcolor cor-recurso
    set cor-inicial cor-aleatoria
    set recurso table:get mapa-cores cor-aleatoria
    set total-recursos total-recursos + recurso
  ]
  
  create-exploradores numero-exploradores [
    set color cor-exploradores
    set shape "car"
    set size 0.7
    move-to one-of patches with [pcolor = cor-base]
    set fov 180
    set dov 8
    set energia energia-exploradores
    set velocidade precision (0.6 + random-float 0.4) 3
    set estado "explorar"
  ]

  create-coletores numero-coletores [
    set color cor-coletores
    set shape "truck"
    set size 1
    move-to one-of patches with [pcolor = cor-base]
    set energia energia-coletores
    set estado "explorar"
    set fov 90
    set dov 2
    set velocidade precision (0.2 + random-float 0.2) 3
    set carga 0
  ]
  
  reset-ticks
end

to go 
  ask exploradores [
    movimento-exploradores
  ]

  ask coletores [
    movimento-coletores
  ]
  
  ;; SISTEMA DE LABELS
  ask turtles [
    ifelse mostrar-energia [
      set label (word "E:" round energia) 
      set label-color white
    ] [
      ifelse mostrar-velocidade [
        set label (word "V:" velocidade)
        set label-color white
      ] [
        ifelse mostrar-carga and breed = coletores [
          set label (word "C:" carga)
          set label-color white
        ] [
          set label ""
        ]
      ]
    ]
  ]

  atualizar-feromonas
  atualizar-recursos

  tick
end

to-report evitar-obstaculos
  let orientacao-inicial heading
  let caminho-livre? orientar-sem-obstaculos? 360 (one-of [1 -1])
  if not caminho-livre? [
    set heading orientacao-inicial
  ]
  report caminho-livre?
end

to-report orientar-sem-obstaculos? [tentativas-restantes passo]
  if tentativas-restantes <= 0 [ report false ]

  let obstaculos-visiveis patches in-cone dov fov with [pcolor = cor-obstaculo]
  let proximo-patch patch-ahead velocidade
  let frente-bloqueada? (proximo-patch = nobody or [pcolor] of proximo-patch = cor-obstaculo)

  if not any? obstaculos-visiveis and not frente-bloqueada? [
    report true
  ]

  right passo
  report orientar-sem-obstaculos? (tentativas-restantes - 1) passo
end

to scan-recursos
  let recursos-encontrados patches in-cone dov fov with [pcolor = cor-recurso]
  if any? recursos-encontrados [
    set estado "recurso-encontrado"
    let recurso-mais-proximo min-one-of recursos-encontrados [distance myself]
    face recurso-mais-proximo
  ]
end

to movimento-exploracao
  if evitar-obstaculos [
    forward velocidade
    set energia (energia - 1)
  ]
end

to movimento-voltar-base
  face centro-base
  if evitar-obstaculos [
    forward velocidade
    set energia (energia - 1)
  ]
end

to movimento-coletores
  let energia-necessaria-voltar ((distance centro-base) * (1 / velocidade)) + 20
  
  if estado = "voltar-base" [
    if carga > 0 and pcolor != cor-base and pcolor != cor-obstaculo and recurso = 0 [
      set feromona min list 100 (feromona + 10)
    ]

    if pcolor = cor-base and energia < energia-coletores [
      set recursos-coletados recursos-coletados + carga
      set energia energia-coletores
      set estado "explorar"
      set carga 0
      stop
    ]
    movimento-voltar-base
  ]
  
  if estado = "explorar" [
    if energia <= energia-necessaria-voltar or carga != 0 [
      set estado "voltar-base"
      stop
    ]

    let recursos-visiveis patches in-cone dov fov with [recurso > 0 and pcolor != cor-recurso]
    let rastos-visiveis patches in-cone (dov + 2) 135 with [feromona > 0]

    ifelse recurso > 0 [
      set pcolor pcolor - 0.5
      set recurso recurso - 1
      set carga 1
      if (recurso = 0) [
        set pcolor cor-recurso - 3
      ]
    ] [
      ifelse any? recursos-visiveis [
        face min-one-of recursos-visiveis [distance myself]
        movimento-exploracao
      ] [
        ifelse any? rastos-visiveis [
          face max-one-of rastos-visiveis [distance myself]
          movimento-exploracao
        ] [
          let rasto-perdido patches in-radius 2 with [feromona > 0]
          ifelse any? rasto-perdido [
            face min-one-of rasto-perdido [distance myself]
            movimento-exploracao
          ] [
            ifelse pcolor != cor-base [ 
              set estado "voltar-base"
            ] [
              set estado "em-base"
            ]
          ]
        ]
      ]
    ]
  ]

  if estado = "em-base" [
    let patches-alvo patches in-cone dov fov with [feromona > 0]
    ifelse any? patches-alvo [
      let patch-mais-perto min-one-of patches-alvo [distance myself]
      set estado "explorar"
      face patch-mais-perto
      movimento-exploracao
    ] [
      right random 360
      if [pcolor] of patch-ahead 1 = cor-base [
        forward velocidade
      ]
    ]
  ]

  if energia <= 0 [
    die
  ]
end

to movimento-exploradores
  let energia-necessaria-voltar ((distance centro-base) * (1 / velocidade)) + 80

  scan-recursos

  if estado = "recurso-encontrado" [
    if pcolor = cor-recurso [
      set pcolor cor-inicial
      set estado "tracar-caminho" 
    ]
    if estado = "recurso-encontrado" [
      movimento-exploracao
    ]
  ]

  if estado = "tracar-caminho" [
    if pcolor != cor-base and pcolor != cor-obstaculo and recurso = 0 [
      set feromona max list feromona 50 
    ]
    
    if pcolor = cor-base [
      set energia energia-exploradores
      set estado "explorar"
    ]
    if estado = "tracar-caminho" [
      movimento-voltar-base
    ]
  ]

  if estado = "voltar-base" [
    if pcolor = cor-base [
      set energia energia-exploradores
      set estado "explorar"
    ]
    movimento-voltar-base
  ]

  if estado = "explorar" [
    if energia <= energia-necessaria-voltar [
      set estado "voltar-base"
    ]
    movimento-exploracao
  ]

  if energia <= 0 [
    die
  ]
end

to atualizar-feromonas
  ask patches with [feromona > 0] [
    set feromona feromona - (feromona / 150)
    
    if feromona < 1 [ 
      set feromona 0 
    ]
    
    if pcolor = cor-vazio or shade-of? pcolor cor-feromona [
      ifelse feromona > 0 [
        set pcolor scale-color cor-feromona feromona -60 260
      ] [
        set pcolor cor-vazio
      ]
    ]
  ]
end

to atualizar-recursos
  ask patches with [recurso > 0 and pcolor != cor-recurso] [
    set tempo-exposto tempo-exposto + 1
    if tempo-exposto >= 400 [
      set pcolor cor-recurso
      set tempo-exposto 0
    ]
  ]
end