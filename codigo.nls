extensions [table]
globals [mapa-cores]

breed [coletores coletor] 
breed [exploradores explorador]


coletores-own [
  velocidade
  energia
  fov
  estado
  dov
  carga
]

exploradores-own [
  velocidade
  energia
  fov
  estado
  dov
]

to setup
  clear-all

  set mapa-cores table:from-list [[red 2] [blue 5] [pink 7]]

  ask patches [
    set pcolor green
  ]
  ask patches [
    if random 101 <= 5 [
      set pcolor gray
    ]
  ]

  ask n-of 5 patches with [pcolor = green and distancexy 0 0 > 3 and pcolor != gray] [
      set pcolor brown
      
  ]
  
  ask patches with [distancexy 0 0 < 3] [
    set pcolor yellow
  ]

  create-exploradores numero-exploradores [
    set color blue
    set shape "car"
    set size 0.7
    setxy -0.5 0
    set fov 180
    set dov 3
    set energia 300
    set velocidade 1
    set estado "explorar"

  ]

  create-coletores numero-coletores [
    set color orange
    set shape "truck"
    set size 1
    setxy 0 0.5
    set energia 200
    set estado "explorar"
    set fov 45
    set dov 1
    set velocidade 0.5
    set carga 0
  ]
  
  reset-ticks
end

to go 
  ask exploradores [
    movimento-exploradores
  ]

  ask coletores [
    movimento-coletores
  ]
  ask turtles [ 
    ifelse mostrar-energia [
      set label round energia  
      set label-color black    
    ] [
      set label ""             
    ]
  ]
  
  tick
end

to evitar-obstaculos
  let proximo-patch patch-ahead 1
  let patch-esq patch-left-and-ahead 45 1
  let patch-dir patch-right-and-ahead 45 1

  let frente-bloqueada? (proximo-patch = nobody or [pcolor] of proximo-patch = gray)
  let esq-bloqueada? (patch-esq = nobody or [pcolor] of patch-esq = gray)
  let dir-bloqueada? (patch-dir = nobody or [pcolor] of patch-dir = gray)

  ifelse frente-bloqueada? and esq-bloqueada? and dir-bloqueada? [
    right 180
  ]
  [
    ifelse frente-bloqueada? [
      right one-of [90 -90]
    ]
    [
      if esq-bloqueada? [ right one-of [45 90] ]
      if dir-bloqueada? [ left one-of [45 90] ]
    ]
  ]
end 

to scan-recursos
  let recursos-encontrados patches in-cone dov fov with [pcolor = brown]
  if any? recursos-encontrados [
    set estado "recurso-encontrado"
    let recurso-mais-proximo min-one-of recursos-encontrados [distance myself]
    facexy [pxcor] of recurso-mais-proximo [pycor] of recurso-mais-proximo
  ]
end

to movimento-exploracao
  evitar-obstaculos        
  forward velocidade
   set energia (energia - 1)
end

to movimento-voltar-base
  facexy 0 0
  evitar-obstaculos
  forward velocidade
   set energia (energia - 1)
end

to movimento-coletores
  let energia-necessaria-voltar ((distancexy 0 0)*(1 / velocidade)) + 20
  
  if estado = "voltar-base"[

    if pcolor = yellow[
      set energia energia + 200
      set estado "explorar"
      set carga 0
      stop
    ]
    movimento-voltar-base
  ]
  
  if estado = "explorar"  [
    
    if energia <= energia-necessaria-voltar or carga != 0 [
      set estado "voltar-base"
      stop
    ]

    let chaves-cores table:keys mapa-cores
  let patches-alvo patches with [
  not empty? filter [ cor-base -> (shade-of? pcolor cor-base) and (pcolor != cor-base - 5) ] chaves-cores
    ]
    if any? patches-alvo [
      if member? patch-here patches-alvo [
      set pcolor pcolor - 1
      set carga 1
    ]
      let patch-mais-perto min-one-of patches-alvo [distance myself]
      face patch-mais-perto
      movimento-exploracao
    ]


  ] 

 
  if energia <= 0 [
    die
  ]
  end

to movimento-exploradores
  let energia-necessaria-voltar ((distancexy 0 0)*(1 / velocidade)) + 20

  scan-recursos

  if estado = "recurso-encontrado" and estado != "voltar-base" [
    if pcolor = brown [
      set pcolor red
      set estado "explorar"
    ]
   movimento-exploracao
  ]

  if estado = "voltar-base"[
    if pcolor = yellow[
      set energia energia + 300
      set estado "explorar"
    ]
    movimento-voltar-base
  ]

  if estado = "explorar"  [
    if energia <= energia-necessaria-voltar [
      set estado "voltar-base"
    ]
    movimento-exploracao
  ]

  if energia <= 0 [
    die
  ]
end
